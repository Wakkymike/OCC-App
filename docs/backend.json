
{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "type": "object",
      "description": "Represents a user's profile within the application.",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "isAdmin": { "type": "boolean", "default": false },
        "isContentCreator": { "type": "boolean", "default": false },
        "isActive": { "type": "boolean", "default": false },
        "passwordChangeRequired": { "type": "boolean", "default": false },
        "forceSignOut": { "type": "boolean", "default": false }
      },
      "required": ["uid", "email", "displayName", "isAdmin", "isContentCreator", "isActive", "passwordChangeRequired", "forceSignOut"]
    },
    "MonitoredHazard": {
      "title": "Monitored Hazard",
      "type": "object",
      "description": "A road restriction being actively monitored via geofencing.",
      "properties": {
        "hazardId": { "type": "string" },
        "type": { "type": "string", "enum": ["height", "width", "both"] },
        "value": { "type": "string" },
        "location": {
          "type": "object",
          "properties": {
            "lat": { "type": "number" },
            "lng": { "type": "number" }
          }
        },
        "description": { "type": "string" },
        "radius": { "type": "number", "description": "Radius in meters for the geofence." },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["hazardId", "type", "value", "location", "radius", "createdAt"]
    },
    "ActiveAlert": {
      "title": "Active Alert",
      "type": "object",
      "description": "An active breach of a geofence by a vehicle.",
      "properties": {
        "busId": { "type": "string" },
        "fleetNumber": { "type": "string" },
        "service": { "type": "string" },
        "hazardId": { "type": "string" },
        "hazardValue": { "type": "string" },
        "hazardDescription": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["busId", "fleetNumber", "service", "hazardId", "hazardValue", "timestamp"]
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/userProfiles/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Stores individual user profiles."
    },
    "/monitoredHazards/{hazardId}": {
      "schema": { "$ref": "#/entities/MonitoredHazard" },
      "description": "Active geofences for road hazards."
    },
    "/activeAlerts/{alertId}": {
      "schema": { "$ref": "#/entities/ActiveAlert" },
      "description": "Live alerts for geofence breaches."
    }
  }
}
