
{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "type": "object",
      "description": "Represents a user's profile within the application.",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "isAdmin": { "type": "boolean", "default": false },
        "isContentCreator": { "type": "boolean", "default": false },
        "isActive": { "type": "boolean", "default": false },
        "passwordChangeRequired": { "type": "boolean", "default": false },
        "forceSignOut": { "type": "boolean", "default": false }
      },
      "required": ["uid", "email", "displayName", "isAdmin", "isContentCreator", "isActive", "passwordChangeRequired", "forceSignOut"]
    },
    "MonitoredHazard": {
      "title": "Monitored Hazard",
      "type": "object",
      "description": "A geofence monitor associated with a road restriction or manual marker.",
      "properties": {
        "hazardId": { "type": "string", "description": "The ID of the source hazard or 'manual'." },
        "type": { "type": "string", "enum": ["height", "width", "both", "manual"] },
        "value": { "type": "string", "description": "The restriction value or manual category." },
        "location": {
          "type": "object",
          "properties": {
            "lat": { "type": "number" },
            "lng": { "type": "number" }
          }
        },
        "geofenceCenter": {
          "type": "object",
          "properties": {
            "lat": { "type": "number" },
            "lng": { "type": "number" }
          }
        },
        "description": { "type": "string" },
        "radius": { "type": "number", "description": "Radius in meters for the geofence." },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["hazardId", "type", "value", "location", "radius", "createdAt"]
    },
    "ActiveAlert": {
      "title": "Active Alert",
      "type": "object",
      "description": "An active breach of a geofence by a vehicle.",
      "properties": {
        "busId": { "type": "string" },
        "fleetNumber": { "type": "string" },
        "service": { "type": "string" },
        "hazardId": { "type": "string" },
        "monitorId": { "type": "string", "description": "The ID of the specific geofence monitor triggered." },
        "hazardValue": { "type": "string" },
        "hazardDescription": { "type": "string" },
        "isAcknowledged": { "type": "boolean", "default": false, "description": "Whether the global overlay has been dismissed." },
        "timestamp": { "type": "string", "format": "date-time" },
        "acknowledgedBy": { "type": "string" },
        "acknowledgedAt": { "type": "string", "format": "date-time" },
        "historyDocId": { "type": "string" }
      },
      "required": ["busId", "fleetNumber", "service", "hazardId", "monitorId", "hazardValue", "timestamp", "isAcknowledged"]
    },
    "AlertHistory": {
      "title": "Alert History",
      "type": "object",
      "description": "A persistent log of geofence breaches for auditing.",
      "properties": {
        "busId": { "type": "string" },
        "fleetNumber": { "type": "string" },
        "service": { "type": "string" },
        "hazardId": { "type": "string" },
        "monitorId": { "type": "string" },
        "hazardValue": { "type": "string" },
        "hazardDescription": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "acknowledgedAt": { "type": "string", "format": "date-time" },
        "acknowledgedBy": { "type": "string" }
      },
      "required": ["busId", "fleetNumber", "service", "hazardId", "monitorId", "hazardValue", "timestamp"]
    },
    "DriverHoursRecord": {
      "title": "Driver Hours Record",
      "type": "object",
      "description": "A log of a driver's daily driving segments and shift calculations.",
      "properties": {
        "driverName": { "type": "string" },
        "employeeNumber": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "segments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "start": { "type": "string" },
              "end": { "type": "string" }
            }
          }
        },
        "totalDrivingMinutes": { "type": "number" },
        "totalShiftMinutes": { "type": "number" },
        "hasBreach": { "type": "boolean" },
        "breachTypes": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/userProfiles/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Stores individual user profiles."
    },
    "/monitoredHazards/{monitorId}": {
      "schema": { "$ref": "#/entities/MonitoredHazard" },
      "description": "Collection of active geofence monitors."
    },
    "/activeAlerts/{alertId}": {
      "schema": { "$ref": "#/entities/ActiveAlert" },
      "description": "Live alerts for geofence breaches."
    },
    "/alertHistory/{historyId}": {
      "schema": { "$ref": "#/entities/AlertHistory" },
      "description": "Permanent log of all historical geofence breaches."
    },
    "/driverHours/{recordId}": {
      "schema": { "$ref": "#/entities/DriverHoursRecord" },
      "description": "Daily driving hours logs."
    }
  }
}
