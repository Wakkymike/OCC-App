rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.email == 'michael.dodsworth@gonorthwest.co.uk';
    }

    // Direct check for roles without nested functions to prevent recursion
    function getUserData() {
      return get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data;
    }

    match /userProfiles/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin() || getUserData().isAdmin == true);
      allow list: if isSignedIn() && (isSuperAdmin() || getUserData().isAdmin == true);
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin() || getUserData().isAdmin == true);
      allow delete: if isSignedIn() && (isSuperAdmin() || getUserData().isAdmin == true);
    }

    match /invitations/{invitationId} {
      allow read, write: if isSignedIn() && (isSuperAdmin() || getUserData().isAdmin == true);
    }

    match /networkUpdates/{updateId} {
      // Everyone who is signed in can read network updates.
      allow read: if isSignedIn();
      
      // Admins and content creators can modify them.
      allow write: if isSignedIn() && (
        isSuperAdmin() || 
        getUserData().isAdmin == true ||
        getUserData().isContentCreator == true
      );
    }

    match /{path=**} {
      allow read, write: if false;
    }
  }
}