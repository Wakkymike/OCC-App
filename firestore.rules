rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.email == 'michael.dodsworth@gonorthwest.co.uk';
    }

    // Direct check for admin status without helper functions to avoid recursive rule evaluation
    function isAdmin() {
      return isSuperAdmin() || get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
    }

    match /userProfiles/{userId} {
      // Users can read their own profile. Admins can read any profile.
      allow get: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin() || isAdmin());
      
      // Only admins can list all profiles.
      allow list: if isSignedIn() && (isSuperAdmin() || isAdmin());
      
      // Users can create their own profile during sign up.
      allow create: if isSignedIn() && request.auth.uid == userId;
      
      // Users can update their own profile (e.g. password change flag). Admins can update any profile.
      allow update: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin() || isAdmin());

      // Only admins or super admins can delete profiles.
      allow delete: if isSignedIn() && (isSuperAdmin() || isAdmin());
    }

    match /invitations/{invitationId} {
      // Invitations are restricted to admins.
      allow read, write: if isSignedIn() && (isSuperAdmin() || isAdmin());
    }

    match /networkUpdates/{updateId} {
      // Everyone who is signed in can read network updates.
      allow read: if isSignedIn();
      
      // Admins and content creators can modify them.
      allow write: if isSignedIn() && (
        isSuperAdmin() || 
        isAdmin() ||
        get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isContentCreator == true
      );
    }

    match /{path=**} {
      allow read, write: if false;
    }
  }
}