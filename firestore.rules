rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.email == 'michael.dodsworth@gonorthwest.co.uk';
    }

    // Helper to check if the current user has a specific role in their profile
    function hasRole(roleField) {
      let profile = get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data;
      return profile != null && profile.get(roleField, false) == true;
    }

    match /userProfiles/{userId} {
      // Users can always read and update their own profile.
      allow get: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin() || hasRole('isAdmin'));
      allow update: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin() || hasRole('isAdmin'));
      
      // Only admins can list all profiles.
      allow list: if isSignedIn() && (isSuperAdmin() || hasRole('isAdmin'));
      
      // A new user can create their own profile document.
      allow create: if isSignedIn() && request.auth.uid == userId;

      allow delete: if false;
    }

    match /invitations/{invitationId} {
      allow read, write: if isSignedIn() && (isSuperAdmin() || hasRole('isAdmin'));
    }

    match /networkUpdates/{updateId} {
      // Everyone who is signed in can read network updates.
      allow read: if isSignedIn();
      
      // Admins and content creators can modify them.
      allow write: if isSignedIn() && (
        isSuperAdmin() || 
        hasRole('isAdmin') ||
        hasRole('isContentCreator')
      );
    }

    match /{path=**} {
      allow read, write: if false;
    }
  }
}