
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * FIRESTORE SECURITY RULES
     */

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'michael.dodsworth@gonorthwest.co.uk' ||
        request.auth.uid == 'QkN2XNYugte0wl1Wfsrmq2elNG22'
      );
    }

    function isAdmin() {
      return isSuperAdmin() || (
        isSignedIn() && exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true
      );
    }

    match /userProfiles/{uid} {
      // Prioritize Super Admin and Owner checks for reliable profile access
      allow get: if isSignedIn() && (request.auth.uid == uid || isSuperAdmin());
      allow list: if isSuperAdmin() || isAdmin();
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if isSignedIn() && (request.auth.uid == uid || isSuperAdmin());
      allow delete: if isSuperAdmin();
    }

    // Call Logs are strictly owned by the user but accessible by Super Admin for oversight
    // Added specific rule for collection listing to prevent permission errors
    match /users/{userId}/callLogs/{callLogId} {
      allow read, list: if isOwner(userId) || isSuperAdmin();
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isOwner(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isOwner(userId) || isSuperAdmin();
    }

    match /invitations/{id} {
      allow read: if true;
      allow write: if isSuperAdmin() || isAdmin();
    }

    match /monitoredHazards/{id} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isAdmin();
    }

    match /activeAlerts/{id} {
      allow read, write: if isSignedIn();
    }

    match /alertHistory/{id} {
      allow read, write: if isSignedIn();
    }

    match /networkUpdates/{id} {
      allow read: if true;
      allow write: if isSuperAdmin() || isAdmin();
    }

    match /driverHours/{id} {
      allow read, write: if isSignedIn();
    }

    match /{path=**} {
      allow read, write: if false;
    }
  }
}
