rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for reusable logic
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    // Function to check if the requesting user has a specific role in their profile.
    function hasRole(roleField) {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.get(roleField, false) == true;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'michael.dodsworth@gonorthwest.co.uk' ||
        hasRole('isAdmin')
      );
    }

    function isContentCreator() {
      return hasRole('isContentCreator');
    }

    match /userProfiles/{userId} {
      // A user can always read and update their own profile.
      allow get: if isOwner(userId) || isAdmin();
      allow update: if isOwner(userId) || isAdmin();
      
      // Only admins can list all profiles.
      allow list: if isAdmin();
      
      // A new user can create their own profile document.
      allow create: if isOwner(userId) && request.resource.data.uid == userId;

      allow delete: if false;
    }

    match /invitations/{invitationId} {
      allow create, list, delete: if isAdmin();
      allow get: if true;
      allow update: if false;
    }

    match /networkUpdates/{updateId} {
      // Everyone can read network updates.
      allow read: if true;
      
      // Only admins and content creators can modify them.
      allow create, update, delete: if isAdmin() || isContentCreator();
    }

    // Default-deny all other collections/documents
    match /{path=**} {
      allow read, write: if false;
    }
  }
}