rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for reusable logic
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    // Function to check if a user is a content creator.
    function isContentCreator() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.get('isContentCreator', false) == true;
    }

    // Function to check if the requesting user is an admin.
    function isAdmin() {
      // Prioritize the hardcoded super admin for immediate access.
      // Then check the database flag. Recursion is avoided because the userProfiles
      // get rule does not call isAdmin().
      return isSignedIn() && (
        request.auth.token.email == 'michael.dodsworth@gonorthwest.co.uk' ||
        (exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.get('isAdmin', false) == true)
      );
    }

    match /userProfiles/{userId} {
      // A user can always get and update their own profile.
      // This rule is critical for breaking recursion in helper functions.
      allow get, update: if isOwner(userId);
      
      // Admins get full read (list) and write (update) access to all profiles.
      allow list, update: if isAdmin();
      
      // A new user can create their own profile document.
      allow create: if isOwner(userId) && request.resource.data.uid == userId;

      allow delete: if false;
    }

    match /invitations/{invitationId} {
      allow create, list, delete: if isAdmin();
      allow get: if true;
      allow update: if false;
    }

    match /networkUpdates/{updateId} {
      // Everyone can read network updates.
      allow read: if true;
      
      // Only admins and content creators can modify them.
      allow create, update, delete: if isAdmin() || isContentCreator();
    }

    // Default-deny all other collections/documents
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
