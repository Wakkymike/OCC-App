rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for reusable logic
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Function to check if the requesting user is an admin.
    // An admin is either the "super admin" by email, or a user with the `isAdmin` flag set to true in their profile.
    // This is the single source of truth for admin privileges in security rules.
    function isAdmin() {
      // Check if the user is the designated super admin by email.
      let isSuperAdmin = request.auth.token.email == 'michael.dodsworth@gonorthwest.co.uk';

      // Check if the user has the isAdmin flag in their profile document.
      // The `exists()` check prevents errors if the profile document doesn't exist yet.
      let isDatabaseAdmin = exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid)) &&
                            get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;

      return isSignedIn() && (isSuperAdmin || isDatabaseAdmin);
    }

    match /userProfiles/{userId} {
      // Admins can get any profile. Users can only get their own.
      allow get: if isOwner(userId) || isAdmin();
      
      // Only admins can list all user profiles.
      allow list: if isAdmin();
      
      // Admins can update any profile. Users can only update their own.
      allow update: if isOwner(userId) || isAdmin();
      
      // A new user can create their own profile document.
      // The UID in the document must match their auth UID.
      allow create: if isOwner(userId) && request.resource.data.uid == userId;

      // Nobody can delete profiles from the client.
      allow delete: if false;
    }

    // Default-deny all other collections/documents
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
