rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for reusable logic
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Function to check if the user is an admin by reading their profile.
    // This is secure because reads to userProfiles are restricted.
    function isAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
    }

    match /userProfiles/{userId} {
      // Users can read their own profile.
      // Admins can read any profile and list all profiles.
      allow get, list: if isOwner(userId) || isAdmin();
      
      // A user can update their own profile.
      // An admin can update any user's profile (to change their admin status).
      allow update: if isOwner(userId) || isAdmin();
      
      // Only a new user can create their own profile document.
      // The UID in the document must match their auth UID.
      allow create: if isOwner(userId) && request.resource.data.uid == userId;

      // Nobody can delete profiles from the client.
      allow delete: if false;
    }

    // Default-deny all other collections/documents
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
