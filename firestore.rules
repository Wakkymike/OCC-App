/**
 * @title Firebase Security Rules for Role-Based Access Control
 * @author Your Name/Team
 * @version 1.0
 *
 * @description
 * This ruleset establishes a secure authorization model for an application
 * with distinct user roles, primarily focusing on a global 'Admin' role.
 *
 * @philosophy
 * The core philosophy is a hybrid model combining strict user ownership for
 * personal data with a global role-based system for administrative privileges.
 * Authorization decisions are designed to be fast and independent, avoiding
 * costly cross-document reads in rules wherever possible.
 *
 * @structure
 * - /userProfiles/{userId}: Stores private user data, accessible only to the
 *   owning user or an administrator.
 * - /roles_admin/{adminId}: A dedicated collection for authorization. The mere
 *   existence of a document here grants a user administrative privileges across
 *   the app.
 * - /roles/{roleId}: Contains public, read-only definitions of roles (e.g.,
 *   'Admin', 'User').
 *
 * @decisions
 * - Admin Rights via Document Existence: A user is an admin if and only if a
 *   document with their UID exists in the `/roles_admin` collection. This is
 *   highly performant (`exists()` check) and secure.
 * - Admin Management is Server-Side: Client-side creation, modification, or
 *   deletion of admin roles in `/roles_admin` is explicitly forbidden to prevent
 *   privilege escalation or lockout scenarios. This must be managed from a
 *   trusted server environment (e.g., Cloud Functions).
 * - User Privacy: Listing all user profiles is disabled to prevent data scraping
 *   and protect user privacy.
 *
 * @denormalization
 * This ruleset heavily relies on denormalization for authorization. Instead of
 * checking a `role` field on a user profile, we use a separate `/roles_admin`
 * collection. This allows for a single, efficient `exists()` call to determine
 * admin status anywhere in the rules, which is impossible to do by querying
 * the `/userProfiles` collection.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for reusable logic
    
    /**
     * Checks if the current request is from an authenticated user.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Checks if the authenticated user's UID matches the provided userId.
     * This is the foundation for the ownership model.
     * @param userId The UID of the document owner.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * Checks if the requesting user has administrative privileges.
     * Admin status is granted by the existence of a document in the
     * /roles_admin collection with the user's UID as the document ID.
     */
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    /**
     * @description
     *   Rules for user profiles. A user can manage their own profile. An admin
     *   can read any user's profile for administrative purposes. Listing all
     *   users is explicitly disallowed to protect user privacy.
     * @path
     *   /userProfiles/{userId}
     * @allow
     *   (create) An authenticated user creating their own profile document.
     *   `request.auth.uid == 'user_abc'`, `path == /userProfiles/user_abc`
     * @deny
     *   (update) A user trying to update another user's profile.
     *   `request.auth.uid == 'user_abc'`, `path == /userProfiles/user_xyz`
     * @principle
     *   Restricts access to a user's own data tree and grants read-only
     *   override access for administrators.
     */
    match /userProfiles/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isOwner(userId) && resource != null && request.resource.data.id == resource.data.id;
      allow delete: if isOwner(userId) && resource != null;
    }

    /**
     * @description
     *   Rules for the admin role collection. The existence of a document in this
     *   collection designates a user as an admin. This collection is read-only
     *   to clients to prevent tampering with admin privileges. Admin management
     *   should be handled by a trusted server environment.
     * @path
     *   /roles_admin/{adminId}
     * @allow
     *   (get) An admin checking if another user is also an admin.
     *   `request.auth.uid == 'admin_one'`, `path == /roles_admin/admin_two`
     * @deny
     *   (create) Any user, including an admin, trying to create a new admin role.
     *   `request.auth.uid == 'admin_one'`, `path == /roles_admin/new_admin`
     * @principle
     *   Enforces "Existence over Content" for a global role and makes critical
     *   authorization data immutable from the client-side.
     */
    match /roles_admin/{adminId} {
      allow get: if isAdmin();
      allow list: if isAdmin();
      // CRITICAL: Writes are disabled. Managing admins must be done via a trusted server.
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description
     *   Rules for the collection of role definitions. This is considered public
     *   reference data that any authenticated user can read. Only administrators
     *   are permitted to create, update, or delete role definitions.
     * @path
     *   /roles/{roleId}
     * @allow
     *   (list) Any signed-in user fetching the list of available roles.
     *   `request.auth.uid != null`
     * @deny
     *   (create) A non-admin user trying to add a new role definition.
     *   `request.auth.uid == 'user_abc'`, user is not an admin.
     * @principle
     *   Secures reference data by allowing public read for authenticated users
     *   while restricting all write operations to administrators.
     */
    match /roles/{roleId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isAdmin() && request.resource.data.id == roleId;
      allow update: if isAdmin() && resource != null && request.resource.data.id == resource.data.id;
      allow delete: if isAdmin() && resource != null;
    }
  }
}