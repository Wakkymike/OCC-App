rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.email == 'michael.dodsworth@gonorthwest.co.uk';
    }

    // Direct check to avoid recursion in rules evaluation
    function getProfileData() {
      return get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data;
    }

    match /userProfiles/{userId} {
      // Users can always read and update their own profile.
      allow get: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin() || getProfileData().get('isAdmin', false) == true);
      allow update: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin() || getProfileData().get('isAdmin', false) == true);
      
      // Only admins can list all profiles.
      allow list: if isSignedIn() && (isSuperAdmin() || getProfileData().get('isAdmin', false) == true);
      
      // A new user can create their own profile document.
      allow create: if isSignedIn() && request.auth.uid == userId;

      allow delete: if false;
    }

    match /invitations/{invitationId} {
      allow read, write: if isSignedIn() && (isSuperAdmin() || getProfileData().get('isAdmin', false) == true);
    }

    match /networkUpdates/{updateId} {
      // Everyone who is signed in can read network updates.
      allow read: if isSignedIn();
      
      // Admins and content creators can modify them.
      allow write: if isSignedIn() && (
        isSuperAdmin() || 
        getProfileData().get('isAdmin', false) == true ||
        getProfileData().get('isContentCreator', false) == true
      );
    }

    match /{path=**} {
      allow read, write: if false;
    }
  }
}
