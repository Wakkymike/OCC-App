rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for reusable logic
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Function to check if the requesting user is an admin.
    // An admin is either the "super admin" by email, or a user with the `isAdmin` flag set to true in their profile.
    // This is the single source of truth for admin privileges in security rules.
    function isAdmin() {
      // A user is an admin if they are signed in AND they are either the super admin by email
      // OR they have the isAdmin flag in their user profile. The `request.auth != null` check
      // short-circuits and prevents errors when no user is signed in.
      return request.auth != null && (
        request.auth.token.email == 'michael.dodsworth@gonorthwest.co.uk' ||
        (
          exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true
        )
      );
    }

    match /userProfiles/{userId} {
      // Admins can get any profile. Users can only get their own.
      allow get: if isOwner(userId) || isAdmin();
      
      // Only admins can list all user profiles.
      allow list: if isAdmin();
      
      // Admins can update any profile. Users can only update their own.
      allow update: if isOwner(userId) || isAdmin();
      
      // A new user can create their own profile document.
      // The UID in the document must match their auth UID.
      allow create: if isOwner(userId) && request.resource.data.uid == userId;

      // Nobody can delete profiles from the client.
      allow delete: if false;
    }

    match /invitations/{invitationId} {
      // Admins can create, list, and delete invitations.
      allow create, list, delete: if isAdmin();
      // An unauthenticated user can read a single invitation to verify it.
      allow get: if true;
      // No one can update an invitation.
      allow update: if false;
    }

    match /networkUpdates/{updateId} {
      // Explicitly allow both get and list for everyone.
      // This covers the public homepage feed and the admin panel's list of all updates.
      allow get, list: if true;
      
      // Explicitly allow write operations only for admins.
      allow create, update, delete: if isAdmin();
    }

    // Default-deny all other collections/documents
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
