
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * CORE SECURITY HELPERS
     */

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Explicit Super Admin Check (Mike)
    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'michael.dodsworth@gonorthwest.co.uk' ||
        request.auth.uid == 'QkN2XNYugte0wl1Wfsrmq2elNG22'
      );
    }

    function isAdmin() {
      return isSuperAdmin() || (
        isSignedIn() && 
        exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true
      );
    }

    /**
     * COLLECTION RULES
     */

    match /userProfiles/{uid} {
      // Direct access for self or Super Admin
      allow get: if isSignedIn() && (request.auth.uid == uid || isSuperAdmin());
      // Listing restricted to admins
      allow list: if isSuperAdmin() || isAdmin();
      // Creation/Update for owner
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if isSignedIn() && (request.auth.uid == uid || isSuperAdmin());
      allow delete: if isSuperAdmin();
    }

    // Call Logs are strictly private to the user but visible to Mike for oversight
    match /users/{userId}/callLogs/{callLogId} {
      allow read, list: if isOwner(userId) || isSuperAdmin();
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isOwner(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isOwner(userId) || isSuperAdmin();
    }

    match /invitations/{id} {
      allow read: if true;
      allow write: if isSuperAdmin() || isAdmin();
    }

    match /monitoredHazards/{id} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isAdmin();
    }

    match /activeAlerts/{id} {
      allow read, write: if isSignedIn();
    }

    match /alertHistory/{id} {
      allow read, write: if isSignedIn();
    }

    match /networkUpdates/{id} {
      allow read: if true;
      allow write: if isSuperAdmin() || isAdmin();
    }

    match /driverHours/{id} {
      allow read, write: if isSignedIn();
    }

    match /{path=**} {
      allow read, write: if false;
    }
  }
}
