
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.email == 'michael.dodsworth@gonorthwest.co.uk';
    }

    function getUserData() {
      let path = /databases/$(database)/documents/userProfiles/$(request.auth.uid);
      return exists(path) ? get(path).data : null;
    }

    function isAdmin() {
      let data = getUserData();
      return isSuperAdmin() || (isSignedIn() && data != null && data.isAdmin == true);
    }

    function isContentCreator() {
      let data = getUserData();
      return isSuperAdmin() || (isSignedIn() && data != null && (data.isAdmin == true || data.isContentCreator == true));
    }

    match /userProfiles/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isSignedIn() && isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isSignedIn() && isAdmin();
    }

    match /monitoredHazards/{hazardId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isAdmin();
    }

    match /activeAlerts/{alertId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    match /alertHistory/{historyId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && isAdmin();
    }

    match /invitations/{invitationId} {
      allow get: if true;
      allow list, create, delete: if isSignedIn() && isAdmin();
    }

    match /networkUpdates/{updateId} {
      allow read: if true;
      allow write: if isSignedIn() && isContentCreator();
    }

    match /{path=**} {
      allow read, write: if false;
    }
  }
}
