# Environment variables for OCC App (local deployment)
# Copy this file to .env.local and fill in the values

# === Auth ===
# Pepper for Argon2id password hashing. Generate a random 32+ char string.
# CRITICAL: Keep this secret. If changed, all existing passwords become invalid.
AUTH_PEPPER=CHANGE_ME_TO_A_RANDOM_SECRET_STRING

# Super admin email — this user has irrevocable admin access and cannot be
# deactivated, deleted, or demoted from the admin panel.
SUPER_ADMIN_EMAIL=admin@example.com

# JWT signing secret. Generate a random 64+ char string.
JWT_SECRET=CHANGE_ME_TO_ANOTHER_RANDOM_SECRET_STRING

# === External APIs ===
# Mapbox access token for maps + geocoding
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Optional override for the live TfGM Metrolink departures backend used by the
# Metrolink Departures page. Defaults to the public trams cloud function.
METROLINK_API_URL=https://europe-west2-tramsfunc.cloudfunctions.net/tramsfunc

# Bus Open Data Service API key
BODS_API_KEY=

# === IRC WebSocket ===
# WebSocket URL for the IRC chat server
NEXT_PUBLIC_IRC_WS_URL=wss://bus.valware.uk:6698

# === Socket.io ===
# The URL clients use to connect to the WebSocket server
NEXT_PUBLIC_SOCKET_URL=http://localhost:9002

# === TLS (optional) ===
# Set both to enable direct HTTPS without a reverse proxy.
# Typically points to Let's Encrypt certs.
# TLS_CERT_PATH=/etc/letsencrypt/live/occ.yourdomain.com/fullchain.pem
# TLS_KEY_PATH=/etc/letsencrypt/live/occ.yourdomain.com/privkey.pem

# === Nominatim (optional) ===
# Self-hosted Nominatim for reverse geocoding (postcode lookup).
# If not set, defaults to http://127.0.0.1:8080.
# NOMINATIM_URL=http://127.0.0.1:8080
